        create or replace table flight_db_flight_db.flight_ref_t
      
      
    using iceberg
      
      
      
      
      
      

      as
      WITH flight_ref_t as (
    SELECT ao.name AS origin_airport
            , ao.type AS origin_type
            , ao.municipality AS origin_municipality
            , ad.name AS destination_airport
