        iso_country,
        iso_region,
        municipality,
        CASE WHEN scheduled_service IS NULL
                THEN NULL
            WHEN scheduled_service = 'no'
                THEN 0
            ELSE 1
        END AS scheduled_service,
        gps_code,
        iata_code,
        local_code,
        home_link,
        wikipedia_link,
        keywords
    FROM flight_db.airport_raw_t
) SELECT * 
FROM airport_prep_t

